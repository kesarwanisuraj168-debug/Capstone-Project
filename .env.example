# ============================================================================
# CampusPulse - Environment Configuration
# ============================================================================

# Database Connection URI (SQLite by default; switch to MySQL if desired)
# Example for MySQL: mysql+pymysql://user:password@localhost:3306/campus
CAMPUS_DATABASE_URL=sqlite:///campus.db

# JWT Secret Key for token generation & verification (change in production)
CAMPUS_SECRET=campus-demo-secret-change-me-please-2026

# Token expiration duration in hours
CAMPUS_TOKEN_TTL_HOURS=24
